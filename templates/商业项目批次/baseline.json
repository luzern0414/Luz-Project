    },
    {
      "milestone": "入库试运行",
      "prerequisite": "收货和上架权限生效",
      "schedule": "首批到货窗口",
      "owner": "入库作业负责人",
      "deliverable": "入库单与上架流水",
      "acceptance": "同一入库单的各商品行分别收货和上架，每笔上架流水关联原单与行"
    },
    {
      "milestone": "出库试运行",
      "prerequisite": "入库流水与期初盘点完成",
      "schedule": "仓方安排足量和短拣订单后",
      "owner": "出库作业负责人",
      "deliverable": "出库单、预占、流水与回执",
      "acceptance": "多行按可用余额预占，复核后待发运，逐行发运扣实拣量并释放原计划预占"
    },
    {
      "milestone": "库内作业核对",
      "prerequisite": "库位批次余额可用",
      "schedule": "仓内试运行期间",
      "owner": "仓库主管",
      "deliverable": "移库单、盘点单、调整记录",
      "acceptance": "库内移库合计守恒，盘点差异经主管批准过账"
    },
    {
      "milestone": "回传联调",
      "prerequisite": "上游测试地址和业务样单就绪",
      "schedule": "双方接口环境开放后",
      "owner": "接口负责人",
      "deliverable": "事件投递与重试记录",
      "acceptance": "实发量可复核，重复投递对应一笔发运流水"
    },
    {
      "milestone": "上线与交接",
      "prerequisite": "两仓签核试运行结果、恢复演练完成",
      "schedule": "授权发布窗口内",
      "owner": "发布负责人",
      "deliverable": "发布、监控与交接记录",
      "acceptance": "在授权仓按单号查账，核对库存并恢复回传"
    }
  ]
