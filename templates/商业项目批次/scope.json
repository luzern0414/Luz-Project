          [
            "实收到货后上架",
            "收货转待上架，上架按实收量增加目标库位账面与可用。"
          ],
          [
            "计划十件，实拣八件",
            "分配预占十件。主管复核后待发运。发运扣账面八件、释放预占十件，可用回升两件。"
          ],
          [
            "同仓移库三件",
            "源库位减三件，目标库位加三件，全仓总量保持原值。"
          ],
          [
            "实盘少两件",
            "主管复核后生成负两件调整流水。"
          ],
          [
            "重复投递发运结果",
            "原事件关联上游回执，同一发运单仅有一笔出库过账。"
          ],
          [
            "同一单号含多个商品行",
            "各行分别收货上架或预占、拣货、复核和发运。同一库位批次累计预占以实时可用量为限，每笔流水可回查原单与行。"
          ]
        ]
      }
    }
