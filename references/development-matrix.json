      "next": "operations",
      "failure_route": "verification",
      "deliverables": [
        {
          "id": "release-notes-pdf",
          "name": "发布说明",
          "audience": "client",
          "format": "pdf",
          "kind": "ops-client-pdf",
          "required": true,
          "path": "docs/03-验收交付/05-发布说明.pdf",
          "producers": [
            "luz-ops",
            "luz-design",
            "luz-writing"
          ],
          "tool": "ops.py client-doc <项目> release-notes"
        },
        {
          "id": "release-report",
          "name": "发布报告",
          "audience": "ops",
          "format": "html",
          "kind": "html",
          "required": true,
          "path": "docs/02-产品开发/08-发布评审.html"
        }
      ],
      "client_dir": "docs/03-验收交付"
    },
    {
      "id": "operations",
      "name": "运行交付",
      "owner": "luz-ops",
      "contributors": [
        "luz-dev"
      ],
      "docs_dir": "docs/02-产品开发",
      "required_inputs": [
        "release"
      ],
      "outputs": [
        "运维手册 PDF（客户版，Word 排版）",
        "runbook",
