      "crawl_focus": "monitoring, backup, incident response and platform operations",
      "approval": "user_final_handoff",
      "next": "handover",
      "failure_route": "release",
      "deliverables": [
        {
          "id": "operations-manual-pdf",
          "name": "运维手册",
          "audience": "client",
          "format": "pdf",
          "kind": "ops-client-pdf",
          "required": true,
          "path": "docs/03-验收交付/06-运维手册.pdf",
          "producers": [
            "luz-ops",
            "luz-design",
            "luz-writing"
          ],
          "tool": "ops.py client-doc <项目> operations-manual"
        },
        {
          "id": "operations-report",
          "name": "运行交付报告",
          "audience": "ops",
          "format": "html",
          "kind": "html",
          "required": true,
          "path": "docs/02-产品开发/09-运维评审.html"
        }
      ],
      "client_dir": "docs/03-验收交付"
    },
    {
      "id": "handover",
      "name": "交付验收",
      "owner": "luz-project",
      "contributors": [
        "luz-ops",
        "luz-writing",
        "luz-design",
        "luz-system",
        "luz-dev"
      ],
      "docs_dir": "docs/03-验收交付",
      "client_dir": "docs/03-验收交付",
      "required_inputs": [
        "operations"
      ],
      "outputs": [
        "使用说明 PDF",
        "验收清单 XLSX（客户逐项签字）",
        "需求变更台账快照 XLSX",
        "交付评审 HTML",
        "data/acceptance/checklist.json"
      ],
      "deliverables": [
        {
          "id": "user-manual",
          "name": "使用说明",
          "audience": "client",
          "format": "pdf",
