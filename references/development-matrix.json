            "luz-writing",
            "luz-design"
          ],
          "tool": "formal_doc.py build（assets/legal/user-terms.md 起草，经 Design 的 Word 排版导出）"
        },
        {
          "id": "privacy-policy-pdf",
          "name": "隐私政策",
          "audience": "client",
          "format": "pdf",
          "kind": "legal-pdf",
          "required": true,
          "path": "docs/03-验收交付/08-隐私政策.pdf",
          "producers": [
            "luz-dev",
            "luz-writing",
            "luz-design"
          ],
          "tool": "formal_doc.py build（assets/legal/privacy-policy.md 起草，经 Design 的 Word 排版导出）"
        }
      ],
      "client_dir": "docs/03-验收交付",
      "standard": "references/dev-documents.md",
      "rule_cards": [
        {
          "skill": "luz-dev",
          "card": "project-handoff",
          "for": "项目模式交接与 Ops 证据"
        }
      ]
    },
    {
      "id": "verification",
      "name": "验收测试",
      "owner": "luz-ops",
      "contributors": [
        "luz-dev",
        "luz-system",
        "luz-design",
        "luz-crawl"
      ],
      "docs_dir": "docs/02-产品开发",
      "required_inputs": [
        "implementation",
        "design",
        "technical-plan"
      ],
      "outputs": [
        "验收测试报告 PDF（客户版，Word 排版）",
        "test matrix",
        "browser and device evidence",
        "risk report"
      ],
      "crawl_focus": "platform test requirements, accessibility, security and runtime references",
      "approval": "user_release_candidate",
      "next": "release",
      "failure_route": "implementation",
      "deliverables": [
        {
          "id": "test-report-pdf",
          "name": "验收测试报告",
          "audience": "client",
          "format": "pdf",
          "kind": "ops-client-pdf",
          "required": true,
          "path": "docs/03-验收交付/04-验收测试报告.pdf",
          "producers": [
            "luz-ops",
            "luz-design",
            "luz-writing"
          ],
          "tool": "ops.py client-doc <项目> test-report"
        },
        {
          "id": "verification-report",
          "name": "验收测试报告",
          "audience": "ops",
          "format": "html",
          "kind": "html",
          "required": true,
          "path": "docs/02-产品开发/07-验收测试评审.html"
        }
      ],
      "client_dir": "docs/03-验收交付"
    },
    {
